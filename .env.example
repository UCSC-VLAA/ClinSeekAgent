# ClinSeekAgent release configuration.
# Copy to .env and fill only the values required by your run.

# Repository and artifact roots
CLINSEEK_DATA_ROOT=/path/to/clinseek_bench
CLINSEEK_MODEL_DIR=/path/to/model_or_checkpoint
BENCH_ROOT=/path/to/multimodal_benchmark_root
IMAGE_ARTIFACT_DIR=tmp/mm_artifacts

# EHR and image MCP endpoints
EHR_MCP_URL=http://127.0.0.1:5003/mcp
IMAGE_MCP_URL=http://127.0.0.1:5203/mcp

# Browser search backend. Optional; omit to use local/no-search mode.
SERPER_API_KEY=

# AWS Bedrock. Either use the default AWS credential chain or a bearer token.
AWS_DEFAULT_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=

# OpenAI-compatible vLLM backend
VLLM_BASE_URL=http://127.0.0.1:4000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=

# Hugging Face gated models / datasets
HF_TOKEN=
