# ClinSeekAgent release configuration.
# Copy to .env and fill only the values required by your run.

# Repository and artifact roots
CLINSEEK_DATA_ROOT=/path/to/clinseek_bench
CLINSEEK_MODEL_DIR=/path/to/model_or_checkpoint
BENCH_ROOT=/path/to/multimodal_benchmark_root
IMAGE_ARTIFACT_DIR=tmp/mm_artifacts

# EHR and image MCP endpoints
EHR_MCP_URL=http://127.0.0.1:5003/mcp
IMAGE_MCP_URL=http://127.0.0.1:5203/mcp

# Optional browser tools (--enable_browser; not part of the paper setting).
SERPER_API_KEY=

# AWS Bedrock. Either use the default AWS credential chain or a bearer token.
AWS_DEFAULT_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=

# Google Vertex AI (Claude). Auth uses Application Default Credentials:
#   gcloud auth application-default login
# VERTEX_REGION accepts "global" (recommended), a multi-region ("us"/"eu"),
# or a specific region such as us-east5.
ANTHROPIC_VERTEX_PROJECT_ID=
VERTEX_REGION=us-east5
# Instead of gcloud ADC you can set GOOGLE_APPLICATION_CREDENTIALS to a
# service-account JSON with roles/aiplatform.user on the project.
# Leave VERTEX_MODEL_ID empty to auto-pick the first model this project
# actually serves (claude-opus-4-6, then claude-sonnet-4-6). Set it only to
# pin one; which Claude models a project/region carries varies.
VERTEX_MODEL_ID=

# OpenAI-compatible backend (--backend vllm): a local vLLM server
# (scripts/run_vllm_server.sh) or any other OpenAI-compatible endpoint.
VLLM_BASE_URL=http://127.0.0.1:4000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=

# Hugging Face gated models / datasets
HF_TOKEN=
