# Data directories
data
data/
datasets/

# Model weights (root-anchored so verl/verl/models/ and similar Python
# packages named "models" still get tracked).
/models
/models/
# verl/verl/models/ is a large Python package (64 files) from the upstream
# verl tree. We only track the single file we patch in this repo — the
# Qwen3.5-MoE Ulysses branch in monkey_patch.py — via the whitelist below.
verl/verl/models/**
!verl/verl/models/
!verl/verl/models/transformers/
!verl/verl/models/transformers/monkey_patch.py
# Other upstream verl subtrees that happen to contain a "models/" dir —
# ignore fully (we don't patch anything inside them).
verl/tests/models/
verl/verl/experimental/vla/models/
logs/
*.safetensors
*.bin
*.pt
*.pth
*.distcp

# Checkpoints
verl/checkpoints/
checkpoints/

# Results and outputs
results/
outputs/
verl/outputs/
openresearcher_ehr/results_benchmark_*/
openresearcher_ehr/subsets_*/
openresearcher_ehr/subset_*/
openresearcher_ehr/diagnoses_*/
node-v25.8.1-linux-x64/

# Environment files
.env

# Wandb logs
wandb/

# Logs
*.log

# Memory/monitoring CSVs
*.csv

# Parquet files
*.parquet

# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environments
.venv/
venv/
# Ignore every child of venvs/ EXCEPT venvs/requirements/*.
venvs/*
!venvs/requirements/
!venvs/requirements/**

# Temp/scratch artifacts
tmp/

# HuggingFace cache
.cache/
.claude/
.codex/

# OS files
.DS_Store

# Third-party sources
flash-attention/