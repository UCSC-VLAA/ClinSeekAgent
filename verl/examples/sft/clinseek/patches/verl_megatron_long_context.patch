-def vocab_parallel_log_probs_from_logits(logits, labels):
-    """TODO(zhangchi.usc1992): We may change the implementation later"""
+def _vocab_parallel_neg_ce(logits, labels):
     from megatron.core import tensor_parallel
 
+    # Megatron's cross entropy upcasts with .float() (a no-op for fp32 input) and then modifies the
+    # tensor in place. When `logits` is a chunk view of a larger tensor that would bump the version
+    # counter of the shared base and break autograd, so always hand it a fresh fp32 copy.
+    logits = logits.float() if logits.dtype != torch.float32 else logits.clone()
     return -tensor_parallel.vocab_parallel_cross_entropy(vocab_parallel_logits=logits, target=labels)
 
 
+def vocab_parallel_log_probs_from_logits(logits, labels, chunk_size: int | None = None):
+    """Vocab-parallel log-probs of `labels` given TP-sharded `logits` ([..., seq, vocab/tp]).
+
+    When VERL_LOGPROB_CHUNK_SIZE (or `chunk_size`) > 0 the sequence dimension is processed in
+    chunks under activation checkpointing, so the full-sequence softmax intermediates that
+    Megatron's cross-entropy saves for backward are never materialized at once. This keeps
+    long-context (e.g. 50K+ tokens) training within GPU memory at the cost of recomputing the
+    cheap cross-entropy in backward. All TP ranks chunk identically, so the all-reduces match.
+    """
+    import os
+
+    if chunk_size is None:
+        chunk_size = int(os.environ.get("VERL_LOGPROB_CHUNK_SIZE", "0"))
+    seq_len = logits.shape[-2]
+    if chunk_size <= 0 or seq_len <= chunk_size or not torch.is_grad_enabled() or not logits.requires_grad:
+        return _vocab_parallel_neg_ce(logits, labels)
+
+    from torch.utils.checkpoint import checkpoint
+
+    outs = []
+    for start in range(0, seq_len, chunk_size):
+        end = min(start + chunk_size, seq_len)
+        outs.append(
+            checkpoint(
+                _vocab_parallel_neg_ce,
+                logits[..., start:end, :],
+                labels[..., start:end],
+                use_reentrant=False,
+            )
+        )
+    return torch.cat(outs, dim=-1)
+
+
